# ---------------------------------------------------------------------------
# Linux Practice Lab — environment variables
# Copy to `.env.local` for local dev, or set these in the Vercel dashboard.
# Secrets are NEVER committed.
# ---------------------------------------------------------------------------

# Public flag: set to "true" only after AUTH_SECRET + GitHub OAuth + DATABASE_URL
# are configured. The app degrades gracefully to anonymous mode when disabled.
NEXT_PUBLIC_AUTH_ENABLED=false

# --- Auth.js (GitHub OAuth) ---
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database (Neon Postgres) ---
# Neon connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb
DATABASE_URL=

# --- Vercel Sandbox (already configured on the project) ---
# Resolved automatically via VERCEL_OIDC_TOKEN; no manual var needed.

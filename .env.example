# ─────────────────────────────────────────────────────────────
# Local development only.
# On Vercel these values are provided automatically once the
# project is linked / deployed — you do NOT need to set them there.
# ─────────────────────────────────────────────────────────────

# The recommended way to authenticate locally is:
#   1. `vercel link`   (create/link a Vercel project)
#   2. `vercel env pull`  → writes VERCEL_OIDC_TOKEN into .env.local
# The SDK then reads that token automatically.

# Only fill these in if you are NOT using `vercel env pull`:
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# Public site URL, used for absolute links and metadata.
# Change this to your own domain after you configure it in Vercel.
NEXT_PUBLIC_SITE_URL=https://linux.qiyuan.icu
